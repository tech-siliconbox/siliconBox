{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "ignore": ["infra/mongodb/*.js", "infra/mongodb/*.mjs", "infra/mongodb/*.cjs"],
  "ignoreBinaries": ["python3.12", "atlas"],
  "workspaces": {
    ".": {},
    "apps/web": {
      "entry": [
        "migrate-mongo-config.js",
        "migrations/*.js",
        "e2e/cms/seed-admin.ts",
        "scripts/*.ts",
        "loadtest/*.ts"
      ],
      "ignore": ["src/cms/payload-types.ts", "loadtest/*.js"],
      "ignoreDependencies": ["@payloadcms/ui"]
    },
    "packages/shared": {}
  }
}
