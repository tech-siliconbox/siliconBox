{
  "name": "@siliconbox/web",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc -p tsconfig.json",
    "test:e2e": "playwright test",
    "db:migrate": "migrate-mongo up -f migrate-mongo-config.js && migrate-mongo status -f migrate-mongo-config.js",
    "cms:types": "payload generate:types && payload generate:importmap",
    "content:import": "payload run scripts/content-import.ts",
    "db:verify-roles": "node scripts/verify-db-roles.ts",
    "content:convert": "payload run scripts/content-convert.ts"
  },
  "dependencies": {
    "@payloadcms/db-mongodb": "^3.94.0",
    "@payloadcms/next": "^3.94.0",
    "@payloadcms/ui": "^3.94.0",
    "@react-pdf/renderer": "^4.9.0",
    "@siliconbox/shared": "workspace:*",
    "better-auth": "^1.7.25",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "graphql": "^16.14.2",
    "html-react-parser": "^6.1.10",
    "ioredis": "^6.0.0",
    "jose": "^6.2.12",
    "mammoth": "^1.13.0",
    "mongodb": "^7.7.0",
    "next": "^16.4.6",
    "payload": "^3.94.0",
    "qrcode": "^1.5.4",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "sanitize-html": "^2.18.0",
    "server-only": "^0.0.1",
    "unpdf": "^1.8.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^26.6.3",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/sanitize-html": "^2.16.2",
    "dom-serializer": "^3.1.1",
    "domhandler": "^6.0.1",
    "domutils": "^4.0.2",
    "htmlparser2": "^12.0.0",
    "migrate-mongo": "^14.0.7",
    "tailwindcss": "^4.3.3"
  }
}
